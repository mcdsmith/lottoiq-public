<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}{% if title %} · {% endif %}LottoIQ Blog</title>
<meta name="description" content="{{ excerpt or description or 'Lottery number stats, trends and analysis for Lotto 6/49, Lotto MAX, Lottario and Ontario 49 — from LottoIQ.ca.' }}">
<link rel="canonical" href="https://lottoiq.ca{{ page.url }}">
<meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ title }}">
<meta property="og:url" content="https://lottoiq.ca{{ page.url }}">
{% if image %}<meta property="og:image" content="https://lottoiq.ca{{ image }}">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/tokens.css">
<link rel="stylesheet" href="/css/site-nav.css">
<link rel="stylesheet" href="/css/blog-posts.css">
</head>
<body>

<nav class="site-nav">
  <div class="inner">
    <a class="logo" href="/">LottoIQ.ca</a>
    <div class="links">
      <a href="/">Home</a>
      <a href="/how-it-works/">How It Works</a>
      <a href="/about/">About</a>
      <a href="/responsible-gambling/">Responsible Gambling</a>
      <a href="/privacy-policy/">Privacy Policy</a>
      <a href="/terms-of-use/">Terms of Use</a>
      <a href="/blog/" class="active">Blog</a>
    </div>
    <a class="cta" href="https://stats.lottoiq.ca/signin/?checkout=monthly">Get<br>Insider</a>
  </div>
</nav>

<main class="wrap">
  {{ content | safe }}
</main>

<p class="trust-line">LottoIQ.ca provides statistical analysis of past lottery draws for entertainment and informational purposes only. Past results do not predict future draws, and no method can improve your odds of winning. Please play responsibly. If gambling is no longer fun, call <a href="https://connexontario.ca/">ConnexOntario</a> at 1-866-531-2600.</p>

<footer class="site-footer">
  <div class="inner">
    <div class="brand-col">
      <p class="brand">LottoIQ.ca</p>
      <p class="tagline">Raw data. Neutral analysis.</p>
      <a href="/terms-of-use/">Terms of Use</a>
    </div>
    <div class="connect">
      <h4>Connect</h4>
      <a href="mailto:info@lottoiq.ca">info@lottoiq.ca</a>
      <a href="/privacy-policy/">Privacy Policy</a>
    </div>
  </div>
  <p class="legal-line">© {{ currentYear }} LottoIQ. All rights reserved.</p>
</footer>

</body>
</html>
