---
layout: base.njk
---
<article class="post">
  <p class="post-back"><a href="/">&larr; All posts</a></p>

  <header class="post-header">
    {% if category %}<p class="post-category">{{ category }}</p>{% endif %}
    <h1>{{ title }}</h1>
    <p class="post-meta">
      <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
    </p>
  </header>

  {% if image %}
  <img class="post-hero" src="{{ image }}" alt="{{ imageAlt or title }}">
  {% endif %}

  <div class="post-body">
    {{ content | safe }}
  </div>

  {% if honestPart %}
  <aside class="honest-part">
    <h2>The Honest Part</h2>
    {{ honestPart | safe }}
  </aside>
  {% endif %}

  <p class="post-disclaimer">
    This post is for informational and entertainment purposes only. LottoIQ does not predict lottery
    outcomes, and no statistical method changes the odds of any individual draw.
  </p>
</article>
